# NutriScan AI - Environment Configuration

# Database Configuration (PostgreSQL by default, or SQLite for local dev/testing)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nutriscan
DATABASE_URL=sqlite+aiosqlite:///./nutriscan.db

# Authentication
JWT_SECRET=super_secret_nutriscan_jwt_key_change_in_production_min32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Multimodal AI Configuration
# AI_PROVIDER can be 'gemini', 'openai', or 'smart_mock' (used if no API key is provided)
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-2.0-flash

# OpenAI alternative:
# AI_PROVIDER=openai
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini

# Server & Security
CORS_ORIGINS=["*"]
MAX_UPLOAD_SIZE_MB=10
