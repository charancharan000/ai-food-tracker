{
  "expo": {
    "name": "NutriScan AI",
    "slug": "nutriscan-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "nutriscan",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "NutriScan AI uses your camera to capture food and calculate nutritional information.",
        "NSPhotoLibraryUsageDescription": "NutriScan AI accesses your gallery to allow selecting meal photos for nutrition analysis."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow NutriScan AI to access your camera to scan meals."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow NutriScan AI to access your photos to select meal images."
        }
      ]
    ]
  }
}
