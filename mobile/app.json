{
  "expo": {
    "name": "FITBRO",
    "slug": "fitbro",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "fitbro",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fitbro.app",
      "infoPlist": {
        "NSCameraUsageDescription": "FITBRO uses your camera to capture food and calculate nutritional information.",
        "NSPhotoLibraryUsageDescription": "FITBRO accesses your gallery to allow selecting meal photos for nutrition analysis."
      }
    },
    "android": {
      "package": "com.fitbro.app",
      "versionCode": 5,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow FITBRO to access your camera to scan meals."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow FITBRO to access your photos to select meal images."
        }
      ]
    ]
  }
}
